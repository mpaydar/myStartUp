generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model ContactRequest {
  id           String   @id @default(uuid())
  firstName    String
  lastName     String
  email        String
  meetingAt    DateTime?
  fileName     String
  fileMimeType String?
  fileSize     Int
  fileBlobUrl  String?
  createdAt    DateTime @default(now())

  @@index([email])
  @@index([createdAt])
  @@index([meetingAt])
}
