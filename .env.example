# PostgreSQL (Prisma). Run: npx prisma db push
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/my_consulting_db?schema=public"

# Resend — inbound lead notifications
RESEND_API_KEY="re_..."
# Or lowercase (supported): resend_api_key="re_..."
RESEND_FROM_EMAIL="SimBay AI <onboarding@resend.dev>"
# With onboarding@resend.dev, Resend only delivers TO your Resend signup email until you verify a domain.
NOTIFICATION_TO_EMAIL="your-resend-account-email@example.com"
# Or lowercase: notification_to_email="..."
# After verifying a domain at https://resend.com/domains , set RESEND_FROM_EMAIL and you can use any recipient.

# Azure Blob — consultation attachments go to container "consultation-attachment" by default
# Option A: full connection string
# AZURE_STORAGE_CONNECTION_STRING="DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net"
# Option B: account name + key (key can be azure_secret_key as in your .env)
AZURE_STORAGE_ACCOUNT_NAME="yourstorageaccountname"
AZURE_STORAGE_ACCOUNT_KEY=""
# Or use the same name you already use for the storage account key:
# azure_secret_key="..."

# Optional override (default: consultation-attachment)
# AZURE_STORAGE_CONTAINER_NAME="consultation-attachment"
# Browser uploads need Blob CORS on the storage account. The app tries to set this
# automatically on first upload-url request; include Content-Type and x-ms-blob-type
# in allowed headers if you configure CORS manually in Azure Portal.
# AZURE_BLOB_CORS_ORIGINS="http://localhost:3000,https://simbayai.vercel.app"
# AZURE_BLOB_CORS_ALLOWED_HEADERS="content-type,x-ms-blob-type,x-ms-blob-content-type,x-ms-version,x-ms-date,x-ms-client-request-id,authorization,accept,origin"

# Twilio SMS — Get Started confirmation text to the lead (optional; email still works without it)
# https://www.twilio.com/docs/messaging/tutorials
TWILIO_ACCOUNT_SID="AC..."
TWILIO_AUTH_TOKEN="..."
# Or the names below (also supported):
# twilio_sid="AC..."
# twilio_secret="..."   # same value as Auth Token in Twilio Console
# E.164 sender you own in Twilio
TWILIO_FROM_NUMBER="+12035550100"
# Or: twilio_from_number="+1..."

ReCaptcha_sitekey="your-site-key"
ReCaptcha_secretKey="your-secret-key"
# Or: NEXT_PUBLIC_RECAPTCHA_SITE_KEY + RECAPTCHA_SECRET_KEY
# Optional minimum score (0–1, default 0.5)
# RECAPTCHA_MIN_SCORE="0.5"
